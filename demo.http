# Tier 5 Microservices — Demo Flow
#
# Spin up: cd deploy && docker compose up -d   (≈18 containers)
# Watch:   http://localhost:15672   (RabbitMQ Management — guest/guest)
#          http://localhost:16686   (Jaeger UI)
#
# Variables are populated by the @name responses below.

@identityHost = http://localhost:5300
@buyerBff     = http://localhost:5010
@sellerBff    = http://localhost:5020
@adminBff     = http://localhost:5030
@notifications = http://localhost:5400

@sellerId  = 11111111-1111-1111-1111-111111111111
@buyerId   = 22222222-2222-2222-2222-222222222222
@adminId   = 33333333-3333-3333-3333-333333333333

###
# 1. Mint a SELLER token (identity-service issues RS256 JWT, BFFs validate via JWKS).
# @name sellerToken
GET {{identityHost}}/demo/token?role=Seller&userId={{sellerId}}

###
# 2. Mint a BUYER token.
# @name buyerToken
GET {{identityHost}}/demo/token?role=Buyer&userId={{buyerId}}

###
# 3. Mint an ADMIN token.
# @name adminToken
GET {{identityHost}}/demo/token?role=Admin&userId={{adminId}}

@seller = {{sellerToken.response.body.token}}
@buyer  = {{buyerToken.response.body.token}}
@admin  = {{adminToken.response.body.token}}

###
# 4. Seller creates a product through the SELLER BFF
#    → catalog-service stores Product, publishes ProductCreatedIntegrationEvent.
# @name newProduct
POST {{sellerBff}}/products
Authorization: Bearer {{seller}}
Content-Type: application/json

{
  "name": "Distributed Widget",
  "price": 25,
  "stock": 50,
  "sellerId": "{{sellerId}}"
}

@productId = {{newProduct.response.body.id}}

###
# 5. Buyer lists published products through the BUYER BFF.
GET {{buyerBff}}/products
Authorization: Bearer {{buyer}}

###
# 6. Buyer places an order through the BUYER BFF.
#    Saga kicks off: OrderPlaced → catalog decrements → StockDecremented →
#    orders confirms → OrderConfirmed → notifications writes a row.
# @name newOrder
POST {{buyerBff}}/orders
Authorization: Bearer {{buyer}}
Content-Type: application/json

{
  "buyerId": "{{buyerId}}",
  "productId": "{{productId}}",
  "quantity": 2
}

@orderId = {{newOrder.response.body.orderId}}

###
# 7. Poll the order — initially "Pending", transitions to "Confirmed" within ~2-5s.
GET {{buyerBff}}/orders/{{orderId}}
Authorization: Bearer {{buyer}}

###
# 8. Verify notification was sent (admin BFF aggregates notifications-service).
GET {{adminBff}}/notifications/by-order/{{orderId}}
Authorization: Bearer {{admin}}

###
# 9. Admin lists all products (cross-tenant).
GET {{adminBff}}/products
Authorization: Bearer {{admin}}

###
# 10. Admin lists all orders.
GET {{adminBff}}/orders
Authorization: Bearer {{admin}}

###
# 11. Admin lists feature flags.
GET {{adminBff}}/feature-flags
Authorization: Bearer {{admin}}

###
# 12. Buyer cancels their own pending order (publishes OrderCancelled → catalog returns stock).
POST {{buyerBff}}/orders/{{orderId}}/cancel
Authorization: Bearer {{buyer}}

###
# 13. Admin force-cancels another order (same flow, bypasses ownership check).
# Replace ORDER_ID with a real id from /orders listing.
# POST {{adminBff}}/orders/ORDER_ID/cancel
# Authorization: Bearer {{admin}}

###
# View the distributed trace in Jaeger:
#   http://localhost:16686
# Search service: buyer-bff. A successful PlaceOrder spans:
#   buyer-bff → orders-api → rabbitmq → catalog-worker → rabbitmq →
#     orders-worker → rabbitmq → notifications-worker
