FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ./
COPY shared/ shared/
COPY services/platform-service/ services/platform-service/

WORKDIR /src/services/platform-service
RUN dotnet restore Platform.sln
RUN dotnet publish src/Platform.Api/Platform.Api.csproj -c Release -o /app /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS="http://0.0.0.0:8080;http://0.0.0.0:8081"
EXPOSE 8080 8081
ENTRYPOINT ["dotnet", "Platform.Api.dll"]
