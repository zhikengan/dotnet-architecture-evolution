{
  "ConnectionStrings": {
    "Marketplace": "Host=localhost;Database=marketplace;Username=marketplace;Password=marketplace"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Outbox": {
    "PollIntervalMilliseconds": 500,
    "BatchSize": 50,
    "MaxRetries": 5
  },
  "FeatureFlags": {
    "CacheSeconds": 30
  },
  "AllowedHosts": "*"
}
