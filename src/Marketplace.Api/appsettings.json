{
  "App": {
    "Name": "Marketplace",
    "SeedOnStartup": true
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=marketplace;Username=marketplace;Password=marketplace"
  },
  "Jwt": {
    "Key": "dev-only-symmetric-key-replace-in-production-32+chars",
    "Issuer": "marketplace",
    "Audience": "marketplace-clients",
    "LifetimeMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
